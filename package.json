{
  "name": "dsh-subscription-auth",
  "version": "0.2.2",
  "description": "订阅会员 OAuth 登录（ChatGPT 等）：配置中心「订阅服务」页登录/注销，自动发现订阅模型列表，按登录状态注册提供商，支持思考强度选择",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HomuraTokido/dsh-subscription-auth.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/chatgpt-auth.mjs && node tests/provider-error.mjs && node tests/malformed-auth-response.mjs && node tests/lib-check.mjs && node tests/apply-wiring.mjs && node tests/reasoning-wire.mjs && node tests/auth-session.mjs && node tests/token-store.mjs && node tests/pi-adapter.mjs"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-alpha.2"
  },
  "dshx": {
    "contributes": {
      "tools": [],
      "skills": []
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1 || ~3.18.5-alpha.1",
    "@earendil-works/pi-ai": "^1.1.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-alpha.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.1-alpha.2"
  }
}
